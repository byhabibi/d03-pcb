(version 1)

(rule "global clearance"
  (constraint clearance (min 0mm)))

(rule "global hole"
  (constraint hole_size (min 0.2mm))
  (constraint hole_clearance (min 0.05mm))
  (constraint hole_to_hole (min 0.2mm)))

(rule "edge clearance"
  (constraint edge_clearance (min 0.2mm)))

(rule "usb clearance"
  (condition "A.Footprint == 'Connector_USB:USB_C_Receptacle_Amphenol_12401548E4-2A'")
  (constraint clearance (min 0mm))
  (constraint solder_mask_bridge (min 0mm)))

(rule "l4 clearance"
  (condition "A.Reference == 'L4'")
  (constraint clearance (min 0mm)))

(rule "mask bridge usb"
  (condition "A.Footprint == 'Connector_USB:USB_C_Receptacle_Amphenol_12401548E4-2A'")
  (constraint solder_mask_bridge (min 0mm)))

(rule "global mask bridge"
  (constraint solder_mask_bridge (min 0mm)))
